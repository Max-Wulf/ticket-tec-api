# Variables consumidas por la aplicación. Valores ficticios.
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/tickettec_test?replicaSet=rs0
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_LARGO
NODE_ENV=development
MAIL_USER=REEMPLAZAR_POR_USUARIO_ETHEREAL
MAIL_PASS=REEMPLAZAR_POR_PASSWORD_ETHEREAL
MAIL_FROM="Ticket/TEC <no-reply@example.invalid>"

# Referencias de la consigna: NO son leídas por el código actual.
# La aplicación usa MONGODB_URI en lugar de MONGO_URL.
# MONGO_URL=mongodb://127.0.0.1:27017/tickettec_test?replicaSet=rs0
# JWT_EXPIRES_IN=1h
# MAIL_HOST=smtp.ethereal.email
# MAIL_PORT=587
# JWT y SMTP tienen estos valores fijados en código.
# Descomentar o cambiar estas referencias no modifica su comportamiento.
